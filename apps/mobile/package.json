{
  "name": "inkura-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android shell for Hohoo. Wraps the APP_MODE deployment (Project 3) into an installable APK.",
  "scripts": {
    "android:add": "cap add android",
    "sync": "cap sync android",
    "open": "cap open android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor #080f28 --splashBackgroundColor #080f28",
    "apk:debug": "cd android && gradlew assembleDebug",
    "apk:release": "cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.8.3"
  }
}
