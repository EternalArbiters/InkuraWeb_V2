# Real values (contains the APP_ACCESS_TOKEN) — never commit.
app.config.json

# Native project is fully regenerable: `npm run android:add && npm run sync`.
# Branding lives in apps/mobile/assets/, not in here.
android/

# Same idea as android/ above, but for iOS — fully regenerable on a Mac via
# `npm run ios:add && npm run sync:ios`. Never generated/committed from
# Windows: `cap add ios` needs CocoaPods, which is Mac-only here.
ios/

# Signing material — never commit.
*.keystore
*.jks
keystore.properties

node_modules/
